# Copia este fichero como .env y rellena los valores.
# El .env no se sube a git porque tiene contraseñas.

# Conexión con MySQL: mysql+pymysql://usuario:contraseña@servidor:puerto/base_de_datos
DATABASE_URL=mysql+pymysql://guitarra_app:tu_contraseña@localhost:3306/guitarra

# Clave para firmar los tokens de sesión. Pon una cadena larga y aleatoria.
SECRET_KEY=cambia_esto_por_una_clave_larga

# Orígenes desde los que se permite llamar a la API (separados por comas).
FRONTEND_ORIGINS=http://localhost:5173
